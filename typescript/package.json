{
  "name": "@raid_ai/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the Raid AI detection API — detect AI-generated and manipulated media, and fact-check claims.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Raid AI <info@raidxai.com>",
  "homepage": "https://docs.raidxai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raid-AI-Corporation/raid-ai-sdks.git",
    "directory": "typescript"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "raid",
    "raidxai",
    "deepfake",
    "ai-detection",
    "forensics",
    "fact-checking",
    "sdk"
  ],
  "scripts": {
    "generate:types": "openapi-typescript ../spec/openapi.yaml -o src/generated/openapi.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
