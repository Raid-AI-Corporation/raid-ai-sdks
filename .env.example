# Copy to `.env` and fill in — `.env` is git-ignored, never commit a real token.
# Drives the live smoke tests; nothing here is hardcoded in the SDK or its tests.

# Your developer token (Raid AI dashboard → Settings → API keys).
# Needs the `image` scope for the default live smoke.
RAID_API_KEY=

# The Raid AI API base URL (required for the live smoke).
RAID_API_BASE_URL=

# Optional: path to a short speech clip to also smoke-test audio detection (needs the `audio`
# scope; audio calls cost credits, so this is opt-in).
RAID_SMOKE_AUDIO_PATH=
